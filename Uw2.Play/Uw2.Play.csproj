<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Uw2.Play</RootNamespace>
        <!-- 뷰어(Uw2.exe)와 나란히 놓이므로 이름을 갈라 둔다. -->
        <AssemblyName>Uw2Play</AssemblyName>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <Version>0.1.0</Version>
    </PropertyGroup>

    <!-- 구워 둔 게임 자산. 실행 파일 옆에 폴더째로 둔다 — 게임 없이도 돈다. -->
    <ItemGroup>
      <Content Include="..\asset\**\*">
        <Link>asset\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Uw2.Game\Uw2.Game.csproj" />
    </ItemGroup>

</Project>
